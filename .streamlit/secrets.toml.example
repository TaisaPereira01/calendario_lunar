# =============================================================================
# .streamlit/secrets.toml — Planner Lunar Integrativo (LOGIN)
#
# COMO USAR:
#   1. Copie este arquivo para  .streamlit/secrets.toml
#   2. Gere o hash da sua senha:  python scripts/gerar_hash_senha.py
#   3. Preencha os valores abaixo.
#
# O arquivo real (secrets.toml) NUNCA é versionado — está no .gitignore.
# A senha em texto NÃO fica em lugar nenhum; só o hash.
# =============================================================================

[auth]

# Nome de usuário para entrar no app.
usuario = "seu_usuario"

# Nome de exibição (aparece no "Logada como ...").
nome = "Seu Nome"

# Hash da senha (NUNCA a senha em texto). Gere com:
#     python scripts/gerar_hash_senha.py
# e cole aqui a linha que ele imprimir.
senha_hash = "COLE_O_HASH_AQUI"

# Nome do cookie de sessão (pode deixar assim).
cookie_name = "planner_lunar_auth"

# Chave secreta que assina o cookie. TROQUE por uma frase longa e aleatória.
cookie_key = "TROQUE_por_uma_frase_secreta_longa_e_aleatoria"

# Quantos dias manter logada antes de pedir a senha de novo.
cookie_expiry_days = 30
