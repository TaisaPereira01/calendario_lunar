# =============================================================================
# .streamlit/secrets.toml — Planner Lunar Integrativo (LOGIN)
#
# COMO USAR:
#   1. Copie este arquivo para  .streamlit/secrets.toml
#   2. Gere o hash da sua senha:  python scripts/gerar_hash_senha.py
#   3. Preencha os valores abaixo.
#
# O arquivo real (secrets.toml) NUNCA é versionado — está no .gitignore.
# A senha em texto NÃO fica em lugar nenhum; só o hash.
# =============================================================================

[auth]

# Nome de usuário para entrar no app.
usuario = "seu_usuario"

# Nome de exibição (aparece no "Logada como ...").
nome = "Seu Nome"

# Hash da senha (NUNCA a senha em texto). Gere com:
#     python scripts/gerar_hash_senha.py
# e cole aqui a linha que ele imprimir.
senha_hash = "COLE_O_HASH_AQUI"

# Nome do cookie de sessão (pode deixar assim).
cookie_name = "planner_lunar_auth"

# Chave secreta que assina o cookie. TROQUE por uma frase longa e aleatória.
cookie_key = "TROQUE_por_uma_frase_secreta_longa_e_aleatoria"

# Quantos dias manter logada antes de pedir a senha de novo.
cookie_expiry_days = 30


# =============================================================================
# DIÁRIO (Google Sheets) — DEC-018 / RF-012 / RF-013
#
# As anotações do diário ficam numa planilha Google PRIVADA, sua. O app acessa
# com uma "conta de serviço" (service account). Passo a passo no README, seção
# "Diário (configuração)". Como no login, nada aqui vai para o git.
# =============================================================================

[diario]

# ID da planilha: na URL da sua planilha, é a parte entre /d/ e /edit.
# Ex.: https://docs.google.com/spreadsheets/d/ESTE_PEDACO/edit
spreadsheet_id = "COLE_O_ID_DA_PLANILHA"

# Nome da aba dentro da planilha (o app cria se não existir). Pode deixar assim.
worksheet = "diario"

# Credencial da conta de serviço (cole os campos do arquivo JSON que o Google
# gera). Compartilhe a planilha com o "client_email" abaixo (permissão Editor).
[diario.service_account]
type = "service_account"
project_id = "SEU_PROJECT_ID"
private_key_id = "COLE_AQUI"
private_key = "-----BEGIN PRIVATE KEY-----\nCOLE_AQUI\n-----END PRIVATE KEY-----\n"
client_email = "algo@seu-project.iam.gserviceaccount.com"
client_id = "COLE_AQUI"
token_uri = "https://oauth2.googleapis.com/token"
