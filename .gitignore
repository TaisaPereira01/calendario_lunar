# ================================================
# .gitignore - Oya (canonico, scaffold `gitignore`)
# ================================================

# Variaveis de ambiente (NUNCA versionar)
.env
.env.*

# Ambiente virtual (fica em C:\venvs, nao no projeto)
venv/
.venv/
env/

# Banco de dados local
# NOTA (projeto): mantidas COMENTADAS por escolha deliberada do projeto —
# `database/protocolos.db` e outros .db sao versionados de proposito (DB e
# regeneravel de schema.sql+seed.sql, mas o projeto opta por versiona-lo).
#data/*.db
#data/*.sqlite
#data/*.sqlite3

# Reports do validate (gerados por --report / Passo 0 do review; regeneram) - FIELD-183
01-docs/03-processo/VALIDATE_REPORT.md
01-docs/03-processo/VALIDATE_CODE_REPORT.md

# ---------------------------------------------------------------
# VERSIONADOS de proposito - NAO ignorar (FIELD-122 / FIELD-208):
#   01-docs/03-processo/radar-snapshots/   (snapshots JSON do radar)
#   RADAR.md                               (retrato de saude do projeto)
# (rtm-exports/ e events.jsonl nao se aplicam - projeto e Lite, sem RTM)
# ---------------------------------------------------------------

# Cache Python
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Pytest e cobertura
.pytest_cache/
.coverage
htmlcov/

# E2E browser (Playwright) - artefatos transitorios
tests/oya-f2-e2e/screenshots/
tests/oya-f2-e2e/downloads_tmp/

# IDEs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Sistema operacional
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# Temporarios
*.tmp
*.bak
*.swp

# Streamlit
.streamlit/secrets.toml

# Distribuicao Python
dist/
build/
*.egg-info/

# ================================================
# Especifico do projeto (preservado da 1.4 — nao perder)
# ================================================
.env.example
ativar.bat
1-docs/
